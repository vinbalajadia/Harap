    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@harap/eslint-config": "workspace:*",
    "@harap/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^10.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.0"
  }
}
