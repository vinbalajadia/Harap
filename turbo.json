{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CORS_ALLOWED_ORIGINS",
    "LOG_LEVEL",
    "NODE_ENV",
    "PORT",
    "SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "VITE_API_URL",
    "VITE_APP_ENV",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_SUPABASE_URL"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
